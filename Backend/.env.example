# Base de datos SQLite (ruta relativa a prisma/schema.prisma)
DATABASE_URL="file:./ticketfr.db"

PORT=3001
CORS_ORIGIN="http://localhost:5173"

# Cambiar en cualquier entorno compartido
JWT_SECRET="cambiar-por-un-secreto-largo"
QR_SECRET="cambiar-por-otro-secreto-largo"

# Habilita el selector de roles de la cabecera (login rápido con usuarios demo)
DEMO_MODE=true

# Reglas de negocio parametrizables
RESERVA_MINUTOS=10
EXTENSION_PENDIENTE_MINUTOS=5
# Segundos que tarda la pasarela simulada en confirmar un pago "sin respuesta"
PASARELA_WEBHOOK_SEGUNDOS=20
